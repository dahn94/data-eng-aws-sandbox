# Copie para .env antes de subir — o compose NÃO sobe sem estas variáveis:
#   cp .env.example .env
DEBEZIUM_VERSION=2.5

# Host pelo qual clientes de fora do Docker (seu job Glue, sua máquina)
# alcançam o Kafka. localhost para uso local; o IP público da EC2 se o Kafka
# estiver rodando lá.
EC2_IP=localhost

# Conexão com o Postgres de origem do CDC. Aponte para o endpoint do RDS
# (output db_instance_address de platform/rds) ou para um Postgres local.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DEFINA-A-MESMA-SENHA-DO-RDS
POSTGRES_DB=dataengsandbox
