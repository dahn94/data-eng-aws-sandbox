# Copie para .env antes de subir:  cp .env.example .env
#
# Credenciais do MinIO. Elas viram AWS_ACCESS_KEY_ID/SECRET para o Spark e para
# o catálogo, porque MinIO fala a API do S3 — o mesmo código autentica nos dois.
# Não são credenciais da AWS e não têm valor fora daqui.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# O S3 não usa região de verdade aqui, mas o SDK exige uma.
AWS_REGION=us-east-1
