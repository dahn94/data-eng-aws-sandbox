# Copie para .env antes de subir:
#   cp .env.example .env
#
# Token do LocalStack Pro (app.localstack.cloud → Auth Tokens).
LOCALSTACK_AUTH_TOKEN=cole-seu-token-aqui

# 1 mantém o estado entre `docker compose down`/`up` (recurso Pro).
LOCALSTACK_PERSISTENCE=1

# 1 liga o log verboso — útil quando um apply falha sem mensagem clara.
LOCALSTACK_DEBUG=0
