# Os parâmetros com que ESTE workload sobe as peças de platform/local.
#
# Versionado de propósito: o `.env` é gitignored, e o nome do contêiner do
# Spark precisa ser o mesmo aqui e no DAG, em qualquer clone.
#
# Precedência, do mais fraco ao mais forte:
#   default no ${VAR:-...} do serviço  <  este arquivo  <  .env deste diretório
#   <  variável exportada no shell
# Ou seja: um `.env` local seu sobrescreve o que está aqui, e é para isso que
# ele serve.

# Identidade: quem olha `docker ps` vê de qual workload é cada contêiner.
MINIO_CONTAINER_NAME=amazonsales-minio
MINIO_SETUP_CONTAINER_NAME=amazonsales-minio-setup
ICEBERG_CATALOG_DB_CONTAINER_NAME=amazonsales-catalog-db
ICEBERG_REST_CONTAINER_NAME=amazonsales-iceberg-rest
GLUE_CONTAINER_NAME=amazonsales-glue
TRINO_CONTAINER_NAME=amazonsales-trino
AIRFLOW_CONTAINER_NAME=amazonsales-airflow

# O DAG deste workload é o que o Airflow monta.
AIRFLOW_DAGS_PATH=../../../../workloads/amazonsales/local/dags
AIRFLOW_DAGS_NAME=amazonsales
