# Os parâmetros com que ESTE workload sobe as peças de platform/local.
#
# Versionado de propósito: o `.env` é gitignored, e um nome de contêiner
# precisa ser o mesmo em qualquer clone.
#
# Precedência, do mais fraco ao mais forte:
#   default no ${VAR:-...} do serviço  <  este arquivo  <  .env deste diretório
#   <  variável exportada no shell

# Identidade: quem olha `docker ps` vê de qual workload é cada contêiner.
MINIO_CONTAINER_NAME={{NOME}}-minio
MINIO_SETUP_CONTAINER_NAME={{NOME}}-minio-setup
